# Signaling server
PORT=4000
REDIS_URL=redis://127.0.0.1:6379
REDIS_REQUIRED=true
EXTERNAL_PEER_SERVER_URL=https://voip.myapp.com/peer-call/

# Feature flags
ENABLE_AUDIO_CALL=true
ENABLE_VIDEO_CALL=false
ENABLE_TEXT_CHAT=false

# Optional external webhook receiver for accepted/ended calls
# Receives POST JSON events: call.accepted and call.ended
CALL_WEBHOOK_URL=https://client.mychat/peer/calls/
